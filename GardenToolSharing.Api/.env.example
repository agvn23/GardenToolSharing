# Copy this file to .env (same folder as docker-compose.yml) and fill in a real value.
# .env should NOT be committed - it's already covered by a typical .gitignore for dotnet/node,
# but double check if you don't have one.

# Any random string, 32+ characters. Used to sign JWTs - must stay the same across restarts,
# or every previously issued token becomes invalid.
JWT_KEY=replace-with-a-long-random-string-32-chars-or-more
